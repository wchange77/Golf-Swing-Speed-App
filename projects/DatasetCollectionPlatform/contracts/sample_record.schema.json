{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golf-swing-speed-app.local/contracts/sample-record.schema.json",
  "title": "Sample Record",
  "type": "object",
  "required": [
    "sampleId",
    "domain",
    "sha256",
    "hashAlgorithm",
    "assetPath",
    "fileSize",
    "sessionId",
    "collector",
    "device",
    "deviceProfile",
    "capturedAt",
    "sourcePath",
    "status"
  ],
  "properties": {
    "sampleId": { "type": "string" },
    "domain": { "type": "string", "enum": ["human_club", "golf_ball_detection"] },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hashAlgorithm": { "type": "string", "enum": ["sha256"] },
    "assetPath": { "type": "string" },
    "annotationPath": { "type": ["string", "null"] },
    "fileSize": { "type": "integer", "minimum": 0 },
    "sessionId": { "type": "string" },
    "collector": { "type": "string" },
    "device": { "type": "string" },
    "deviceProfile": { "type": "string" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "sourcePath": { "type": "string" },
    "shotId": { "type": ["string", "null"] },
    "takeIndex": { "type": "integer", "minimum": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "fps": { "type": "integer", "minimum": 1 },
        "resolution": { "type": "string" },
        "clubType": { "type": "string" },
        "handedness": { "type": "string", "enum": ["left", "right", "unknown"] },
        "swingIntensity": { "type": "string", "enum": ["warmup", "normal", "max", "unknown"] },
        "surface": { "type": "string" },
        "referenceMeasurements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "capturedAt"],
            "properties": {
              "source": { "type": "string" },
              "device": { "type": ["string", "null"] },
              "capturedAt": { "type": "string", "format": "date-time" },
              "clubSpeedMph": { "type": ["number", "null"], "minimum": 0 },
              "ballSpeedMph": { "type": ["number", "null"], "minimum": 0 },
              "carryDistanceMeters": { "type": ["number", "null"], "minimum": 0 },
              "totalDistanceMeters": { "type": ["number", "null"], "minimum": 0 },
              "launchAngleDegrees": { "type": ["number", "null"] },
              "spinRateRpm": { "type": ["number", "null"], "minimum": 0 },
              "landingLocation": {
                "type": ["object", "null"],
                "required": ["latitude", "longitude", "horizontalAccuracyMeters", "capturedAt", "source"],
                "properties": {
                  "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
                  "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
                  "horizontalAccuracyMeters": { "type": "number", "minimum": 0 },
                  "altitudeMeters": { "type": ["number", "null"] },
                  "verticalAccuracyMeters": { "type": ["number", "null"], "minimum": 0 },
                  "capturedAt": { "type": "string", "format": "date-time" },
                  "source": { "type": "string" }
                },
                "additionalProperties": false
              },
              "notes": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "status": { "type": "string", "enum": ["active", "archived"] }
  },
  "additionalProperties": false
}
